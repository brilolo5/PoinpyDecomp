event_inherited();
audioVarFruitDrop = 0;
grav = 0.125;
gravityEnabled = 1;
maxFallSpeed = 4;
launchSpeed = random_range(1, 2);
var _launchRandomAngle = 15;
_launchRandomAngle = random_range(-_launchRandomAngle, _launchRandomAngle);
launchDirection = _launchRandomAngle + 90;
xsp = lengthdir_x(launchSpeed, launchDirection);
ysp = lengthdir_y(launchSpeed, launchDirection);
cx = 0;
cy = 0;
startBlinkingAfter = 20;
destroyAfter = 40;
xShrink = 1;
yShrink = 1;
xscaleBase = 0.1;
yscaleBase = 0.1;
xscale = xShrink * xscaleBase;
yscale = yShrink * yscaleBase;
mask_index = mask_16x16;
sprite_index = getFruitSprite(UnknownEnum.Value_0);
image_index = 2;
image_speed = 0;
