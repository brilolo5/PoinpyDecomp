function __scribble_config_default_template()
{
    starting_format(global.__scribble_default_font, 16777215);
    align(0, 0);
    blend(16777215, 1);
    transform(1, 1, 0);
    origin(0, 0);
    wrap(-1, -1, false);
    line_height(-1, -1);
    page(0);
    ignore_command_tags(false);
    typewriter_off();
}
